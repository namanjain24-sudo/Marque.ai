POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=marque

# F4 Signal Check (vision LLM via OpenRouter). Get a key at openrouter.ai.
# Leave blank to disable the signal-check endpoint (it 503s instead of crashing).
OPENROUTER_API_KEY=
OPENROUTER_SIGNAL_MODEL=qwen/qwen3-vl-32b-instruct

# Where uploaded images (F8 saved assets, F10 audit) are stored on disk and
# served from at /media. Defaults to "media" (relative to the backend workdir).
MEDIA_ROOT=media

# Hero image generation (optional, paid — ~$0.04/image, 4 per campaign).
# Set MARQUE_HERO_IMAGES=1 to generate a background photo per campaign asset.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
MARQUE_HERO_IMAGES=1
